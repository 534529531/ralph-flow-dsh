{
  "name": "ralphflow-dsh",
  "version": "2.1.1",
  "description": "Ralph Flow for DeepSeek Harness — 执行者/验证者模式的具象化：主会话执行，独立验证者对抗检查，推进权在机械程序（v2 原生重做）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "workflows",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/534529531/ralph-flow-dsh.git"
  },
  "homepage": "https://github.com/534529531/ralph-flow-dsh#readme",
  "bugs": {
    "url": "https://github.com/534529531/ralph-flow-dsh/issues"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "node scripts/verify-all.mjs",
    "prepublishOnly": "npm run build && npm run typecheck && npm run verify"
  }
}
