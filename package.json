{
  "name": "ralphflow-dsh",
  "version": "2.2.0",
  "description": "Ralph Flow for DeepSeek Harness — 执行者/验证者模式的具象化：主会话执行，独立验证者对抗检查，推进权在机械程序（v2 原生重做）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.d.ts",
      "default": "./lib/typert.js"
    }
  },
  "files": [
    "lib",
    "workflows",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "external": [
        "react",
        "@deepseek-ai/dsh-api-gateway/client",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/534529531/ralph-flow-dsh.git"
  },
  "homepage": "https://github.com/534529531/ralph-flow-dsh#readme",
  "bugs": {
    "url": "https://github.com/534529531/ralph-flow-dsh/issues"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-subagent": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-compaction": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-registry": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-gateway": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-query": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-alpha.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-compaction": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.1",
    "typescript": "^5.9.3",
    "@deepseek-ai/dsh": "0.2.1-alpha.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "node scripts/verify-all.mjs",
    "prepublishOnly": "npm run build && npm run typecheck && npm run verify"
  }
}
